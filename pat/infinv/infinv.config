{
  "scripts": [ "/pat/infinv/InfiniteInventory.lua" ],
  "scriptDelta": 1,
  "scriptWidgetCallbacks": [
    "TabList._select",
    "ItemGrid._slotLeft",
    "ItemGrid._slotRight",
    "IconPicker._slotLeft",
    "IconPicker._slotRight",
    "IconPicker._select",
    "BorderPicker._select",
    "BackingPicker._select",
    "BorderColorbox._input",
    "BackingColorbox._input",
    "Callbacks.newTabButton",
    "Callbacks.moveTabButton",
    "Callbacks.deleteTabButton",
    "Callbacks.sortButton",
    "Callbacks.quickStackButton",
    "Callbacks.takeAllButton",
    "Callbacks.quickMoveCheckbox",
    "Callbacks.tabConfigCheckbox",
    "Callbacks.tabIconRotateButton",
    "Callbacks.tabSetDefault",
    "Callbacks.tabResetToDefault",
    "Callbacks.tabBackingFullCheckbox",
    "Callbacks.tabLabelTextbox",
    "Callbacks.changePage",
    "Callbacks.focusPageBox",
    "Callbacks.blurPageBox",
    "Callbacks.pageBox",
    "Callbacks.search",
    "Callbacks.searchButton",
    "Callbacks.searchEnter",
    "Callbacks.searchTabbed",
    "Callbacks.blur"
  ],

  "strings": {
    "tooltips": {
      "newTabButton": "Create New Bag",
      "tabConfigCheckbox": "Edit Bag",
      "gridLayout.sortButton": "Sort Items",
      "gridLayout.quickStackButton": "Quick Stack",
      "gridLayout.takeAllButton": "Take All",
      "gridLayout.quickMoveCheckbox": "Toggle Quick-moving",
      "gridLayout.prevPageButton": "Previous Page",
      "gridLayout.nextPageButton": "Next Page",
      "editorLayout.moveTabUpButton": "Move Bag Up",
      "editorLayout.moveTabDownButton": "Move Bag Down",
      "editorLayout.deleteTabButton": "Delete Empty Bag",
      "editorLayout.editorTabs.tabs.icon.rotateIconButton": "Rotate Icon",
      "tabIconSlot": "Insert item to use as icon",
      "search.results": "^green;[ENTER]^reset;/^green;[TAB]^reset; to go next matching page",
      "tabSetDefault": "Set current border & slot as default",
      "tabResetToDefault": "Reset border & slot to default"
    },
    "defaultTabSubtitle": "Bag #%s",
    "pageText": "^shadow;%s/%s",
    "searchResultText": "^shadow;%s matches in %s pages"
  },

  "gui": {
    "pane": {
      "type": "background",
      "fileHeader": "/pat/infinv/images/panesize.png?scalenearest=250;25",
      "fileBody": "/pat/infinv/images/panesize.png?scalenearest=250;127",
      "fileFooter": "/pat/infinv/images/panesize.png?scalenearest=250;14"
    },
    "bgStretch": {
      "type": "layout",
      "layoutType": "basic",
      "zlevel": -9999,
      "scissoring": false,
      "mouseTransparent": true,
      "children": {
        "header": {
          "type": "imageStretch",
          "rect": [ 0, 140, 250, 166 ],
          "stretchSet": {
            "begin": "/pat/infinv/images/borders/base.png:header.begin",
            "inner": "/pat/infinv/images/borders/base.png:header.inner",
            "end": "/pat/infinv/images/borders/base.png:header.end"
          }
        },
        "body": {
          "type": "imageStretch",
          "rect": [ 0, 15, 250, 140 ],
          "stretchSet": {
            "begin": "/pat/infinv/images/borders/base.png:body.begin",
            "inner": "/pat/infinv/images/borders/base.png:body.inner",
            "end": "/pat/infinv/images/borders/base.png:body.end"
          }
        },
        "footer": {
          "type": "imageStretch",
          "rect": [ 0, 0, 250, 15 ],
          "stretchSet": {
            "begin": "/pat/infinv/images/borders/base.png:footer.begin",
            "inner": "/pat/infinv/images/borders/base.png:footer.inner",
            "end": "/pat/infinv/images/borders/base.png:footer.end"
          }
        },
        "back": {
          "type": "imageStretch",
          "zlevel": -10,
          "rect": [ 1, 14, 249, 141 ],
          "stretchSet": { "inner": "/pat/infinv/images/back.png" }
        }
      }
    },
    "titleIcon": {
      "type": "image",
      "position": [ 4, 142 ],
      "zlevel": -999,
      "drawables": [
        { "image": "/interface/inventory/portrait.png", "centered": false },
        { "image": "/pat/infinv/images/icon.png", "centered": false, "position": [ 2, 2 ] }
      ]
    },
    "titleText": {
      "type": "label",
      "position": [ 29, 154 ],
      "zlevel": -999,
      "value": "^shadow;Infiniter Inventory"
    },
    "subtitleText": {
      "type": "label",
      "position": [ 29, 144 ],
      "zlevel": -999,
      "color": "lightgray",
      "value": "^shadow;Hash Brown"
    },
    "close": {
      "type": "button",
      "position": [ 234, 147 ],
      "pressedOffset": [ 0, 0 ],
      "base": "/interface/x.png",
      "hover": "/interface/xhover.png",
      "pressed": "/interface/xpress.png"
    },
    "newTabButton": {
      "type": "button",
      "callback": "Callbacks.newTabButton",
      "position": [ 7, 2 ],
      "pressedOffset": [ 0, 0 ],
      "base": "/pat/infinv/images/buttons/plus.png:base",
      "hover": "/pat/infinv/images/buttons/plus.png:base?multiply=aff",
      "pressed": "/pat/infinv/images/buttons/plus.png:press?multiply=0ff"
    },
    "tabConfigCheckbox": {
      "type": "button",
      "checkable": true,
      "callback": "Callbacks.tabConfigCheckbox",
      "position": [ 21, 2 ],
      "pressedOffset": [ 0, 0 ],
      "base": "/pat/infinv/images/buttons/edit.png:base",
      "hover": "/pat/infinv/images/buttons/edit.png:base?multiply=faf",
      "pressed": "/pat/infinv/images/buttons/edit.png:press?multiply=f0f",
      "baseImageChecked": "/pat/infinv/images/buttons/edit.png:press?multiply=faf",
      "hoverImageChecked": "/pat/infinv/images/buttons/edit.png:press?multiply=f0f",
      "pressedImageChecked": "/pat/infinv/images/buttons/edit.png:base"
    },
    "searchButton": {
      "type": "button",
      "callback": "Callbacks.searchButton",
      "position": [ 214, 147 ],
      "pressedOffset": [ 0, -1 ],
      "scissoring": false,
      "base": "/pat/infinv/images/search/search.png",
      "hover": "/pat/infinv/images/search/search.png?brightness=30",
      "pressed": "/pat/infinv/images/search/search.png?brightness=60?saturation=8"
    },
    "search": {
      "type": "layout",
      "layoutType": "basic",
      "visible": false,
      "scissoring": false,
      "position": [ 140, 143 ],
      "children": {
        "background": {
          "type": "image",
          "file": "/pat/infinv/images/search/searchbox.png",
          "mouseTransparent": true
        },
        "textbox": {
          "type": "textbox",
          "callback": "Callbacks.search",
          "enterKey": "Callbacks.searchEnter",
          "position": [ 5, 2 ],
          "hint": "^#444;Search",
          "nextFocus": "tabNext",
          "prevFocus": "tabPrev",
          "maxWidth": 67
        },
        "tabNext": {
          "type": "textbox",
          "visible": false,
          "callback": "Callbacks.searchTabbed"
        },
        "tabPrev": {
          "type": "textbox",
          "visible": false,
          "callback": "Callbacks.searchTabbed",
          "data": true
        },
        "results": {
          "type": "label",
          "fontSize": 7,
          "position": [ 74, 12 ],
          "hAnchor": "right"
        }
      }
    },
    "bagTabs": {
      "type": "scrollArea",
      "rect": [ 3, 15, 46, 140 ],
      "children": {
        "list": {
          "type": "list",
          "callback": "TabList._select",
          "scissoring": false,
          "data": {
            "initChildren": [ "button", "highlight" ],
            "defaultIconMaxIndex": 9,
            "iconTemplate": {
              "type": "image",
              "position": [ 16, 8 ],
              "maxSize": [ 30, 18 ],
              "zlevel": 2,
              "centered": true,
              "mouseTransparent": true
            }
          },
          "schema": {
            "selectedBG": "/pat/infinv/images/tab/selectedbg.png",
            "spacing": [ 0, 1 ],
            "memberSize": [ 32, 16 ],
            "listTemplate": {
              "background": { "type": "image", "zlevel": -10 },
              "button": {
                "type": "button",
                "callback": "null",
                "position": [ 0, -1 ],
                "pressedOffset": [ 0, 0 ],
                "base": "/pat/infinv/images/tab/button.png:base",
                "hover": "/pat/infinv/images/tab/button.png:hover",
                "pressed": "/pat/infinv/images/tab/button.png:pressed"
              },
              "highlight": {
                "type": "image",
                "zlevel": -9,
                "visible": false,
                "mouseTransparent": true,
                "file": "/pat/infinv/images/tab/highlight.png"
              }
            }
          }
        }
      }
    },
    "bagScrollBar": {
      "type": "imageStretch",
      "rect": [ 36, 14, 47, 141 ],
      "zlevel": -100,
      "direction": "vertical",
      "stretchSet": {
        "begin": "/pat/infinv/images/scrollback.png:begin",
        "inner": "/pat/infinv/images/scrollback.png:inner",
        "end": "/pat/infinv/images/scrollback.png:end"
      }
    },
    "gridLayout": {
      "type": "layout",
      "layoutType": "basic",
      "scissoring": false,
      "children": {
        "slots": {
          "type": "container",
          "position": [ 53, 22 ],
          "callback": "null",
          "scissoring": false,
          "data": {
            "showBackingImageWhenEmpty": true,
            "showBackingImageWhenFull": false,
            "backingImage": "/pat/infinv/images/slots/empty.png",
            "dimmedImage": "/pat/infinv/images/slots/dim.png?addmask=<backing>",
            "highlight": {
              "image": "/pat/infinv/images/slots/highlight.png:<frame>?addmask=<backing>?border=1;C88B28",
              "frames": 16,
              "cycle": 1.6
            },
            "countColor": "white",
            "countColorDim": "darkgray",

            "dimensions": [ 10, 6 ],
            "spacing": [ 19, 19 ],
            "template": {
              "slot": {
                "type": "itemslot",
                "showCount": false,
                "showRarity": true,
                "showDurability": true,
                "backingImage": "",
                "callback": "ItemGrid._slotLeft",
                "rightClickCallback": "ItemGrid._slotRight"
              },
              "count": {
                "type": "label",
                "zlevel": 20,
                "position": [ 20, -3 ],
                "mouseTransparent": true,
                "scissoring": false,
                "hAnchor": "right",
                "directives": "border=1;444;0000"
              },
              "backing": {
                "type": "image",
                "zlevel": -10,
                "mouseTransparent": true
              },
              "highlight": {
                "type": "image",
                "zlevel": 10,
                "position": [ -1, -1 ],
                "visible": false,
                "mouseTransparent": true
              },
              "dimmed": {
                "type": "image",
                "zlevel": 10,
                "visible": false,
                "mouseTransparent": true
              }
            }
          }
        },
        "prevPageButton": {
          "type": "button",
          "callback": "Callbacks.changePage",
          "data": -1,
          "position": [ 100, 2 ],
          "pressedOffset": [ -1, 0 ],
          "scissoring": false,
          "base": "/pat/infinv/images/buttons/pagearrow.png",
          "hover": "/pat/infinv/images/buttons/pagearrow.png?multiply=aff",
          "pressed": "/pat/infinv/images/buttons/pagearrow.png?multiply=0ff",
          "baseImageChecked": "/pat/infinv/images/buttons/pagearrowoutline.png",
          "hoverImageChecked": "/pat/infinv/images/buttons/pagearrowoutline.png?multiply=aff",
          "pressedImageChecked": "/pat/infinv/images/buttons/pagearrowoutline.png?multiply=0ff"
        },
        "nextPageButton": {
          "type": "button",
          "callback": "Callbacks.changePage",
          "data": 1,
          "position": [ 140, 2 ],
          "pressedOffset": [ 1, 0 ],
          "scissoring": false,
          "base": "/pat/infinv/images/buttons/pagearrow.png?flipx",
          "hover": "/pat/infinv/images/buttons/pagearrow.png?flipx?multiply=aff",
          "pressed": "/pat/infinv/images/buttons/pagearrow.png?flipx?multiply=0ff",
          "baseImageChecked": "/pat/infinv/images/buttons/pagearrowoutline.png?flipx",
          "hoverImageChecked": "/pat/infinv/images/buttons/pagearrowoutline.png?flipx?multiply=aff",
          "pressedImageChecked": "/pat/infinv/images/buttons/pagearrowoutline.png?flipx?multiply=0ff"
        },
        "pageLabel": {
          "type": "button",
          "callback": "Callbacks.focusPageBox",
          "invisible": true,
          "scissoring": false,
          "size": [ 23, 11 ],
          "position": [ 114, 2 ]
        },
        "pageTextbox": {
          "type": "textbox",
          "callback": "Callbacks.pageBox",
          "enterKey": "Callbacks.blur",
          "blur": "Callbacks.blurPageBox",
          "textAlign": "center",
          "hint": "Page #",
          "regex": "[0-9]*",
          "visible": false,
          "size": [ 28, 9 ],
          "position": [ 111, 3 ]
        },
        "pageTextboxBg": {
          "type": "image",
          "file": "/pat/infinv/images/tab/pagetextbox.png",
          "zlevel": -2,
          "scissoring": false,
          "visible": false,
          "position": [ 109, 2 ]
        },
        "pageScroller": {
          "type": "scrollArea",
          "rect": [ 47, 15, 248, 140 ],
          "verticalScroll": false
        },
        "pageBar": {
          "type": "canvas",
          "rect": [ 47, 15, 248, 17 ],
          "data": { "backColor": "#303030", "color": "#707070", "speed": 0.75 }
        },
        "sortButton": {
          "type": "button",
          "callback": "Callbacks.sortButton",
          "position": [ 232, 2 ],
          "pressedOffset": [ 0, 0 ],
          "base": "/pat/infinv/images/buttons/sort.png:base",
          "hover": "/pat/infinv/images/buttons/sort.png:base?multiply=faa",
          "pressed": "/pat/infinv/images/buttons/sort.png:press?multiply=f00"
        },
        "quickStackButton": {
          "type": "button",
          "callback": "Callbacks.quickStackButton",
          "position": [ 218, 2 ],
          "pressedOffset": [ 0, 0 ],
          "base": "/pat/infinv/images/buttons/quickstack.png:base",
          "hover": "/pat/infinv/images/buttons/quickstack.png:base?multiply=ffa",
          "pressed": "/pat/infinv/images/buttons/quickstack.png:press?multiply=ff0"
        },
        "takeAllButton": {
          "type": "button",
          "callback": "Callbacks.takeAllButton",
          "position": [ 206, 2 ],
          "pressedOffset": [ 0, 0 ],
          "base": "/pat/infinv/images/buttons/takeall.png:base",
          "hover": "/pat/infinv/images/buttons/takeall.png:base?multiply=afa",
          "pressed": "/pat/infinv/images/buttons/takeall.png:press?multiply=0f0"
        },
        "quickMoveCheckbox": {
          "type": "button",
          "checkable": true,
          "callback": "Callbacks.quickMoveCheckbox",
          "position": [ 192, 2 ],
          "pressedOffset": [ 0, 0 ],
          "base": "/pat/infinv/images/buttons/quickmove.png:base",
          "hover": "/pat/infinv/images/buttons/quickmove.png:base?multiply=aff",
          "pressed": "/pat/infinv/images/buttons/quickmove.png:press?multiply=0ff",
          "baseImageChecked": "/pat/infinv/images/buttons/quickmove.png:press?multiply=aff",
          "hoverImageChecked": "/pat/infinv/images/buttons/quickmove.png:press?multiply=0ff",
          "pressedImageChecked": "/pat/infinv/images/buttons/quickmove.png:base"
        }
      }
    },
    "editorLayout": {
      "type": "layout",
      "layoutType": "basic",
      "scissoring": false,
      "visible": false,
      "children": {
        "labelBg": {
          "type": "image",
          "position": [ 57, 122 ],
          "file": "/pat/infinv/images/editor/textbox.png"
        },
        "labelTextbox": {
          "type": "textbox",
          "hint": "^#444;Bag name",
          "position": [ 61, 125 ],
          "maxWidth": 75,
          "callback": "Callbacks.tabLabelTextbox",
          "enterKey": "Callbacks.blur"
        },
        "moveTabUpButton": {
          "type": "button",
          "callback": "Callbacks.moveTabButton",
          "data": -1,
          "position": [ 202, 124 ],
          "pressedOffset": [ 0, 0 ],
          "base": "/pat/infinv/images/buttons/arrow.png:up",
          "hover": "/pat/infinv/images/buttons/arrow.png:up?multiply=afa",
          "pressed": "/pat/infinv/images/buttons/arrow.png:upPress?multiply=0f0"
        },
        "moveTabDownButton": {
          "type": "button",
          "callback": "Callbacks.moveTabButton",
          "data": 1,
          "position": [ 214, 124 ],
          "pressedOffset": [ 0, 0 ],
          "base": "/pat/infinv/images/buttons/arrow.png:down",
          "hover": "/pat/infinv/images/buttons/arrow.png:down?multiply=afa",
          "pressed": "/pat/infinv/images/buttons/arrow.png:downPress?multiply=0f0"
        },
        "deleteTabButton": {
          "type": "button",
          "callback": "Callbacks.deleteTabButton",
          "position": [ 228, 123 ],
          "pressedOffset": [ 0, 0 ],
          "base": "/pat/infinv/images/buttons/trash.png:base",
          "hover": "/pat/infinv/images/buttons/trash.png:base?multiply=faa",
          "pressed": "/pat/infinv/images/buttons/trash.png:press?multiply=f00"
        },
        "editorTabs": {
          "type": "tabSet",
          "tabButtonBaseImage": "/pat/infinv/images/editor/tab.png:base",
          "tabButtonHoverImage": "/pat/infinv/images/editor/tab.png:hover",
          "tabButtonPressedImage": "/pat/infinv/images/editor/tab.png:selected",
          "tabButtonBaseImageSelected": "/pat/infinv/images/editor/tab.png:selected",
          "tabButtonHoverImageSelected": "/pat/infinv/images/editor/tab.png:selected",
          "tabButtonPressedOffset": [ 0, -1 ],
          "tabButtonTextOffset": [ 0, -1 ],
          "tabButtonSpacing": [ -1, 0 ],
          "rect": [ 56, 15, 248, 120 ],
          "zlevel": 1,
          "tabs": [
            {
              "tabName": "icon",
              "tabTitle": "Icon",
              "children": {
                "rotateIconButton": {
                  "type": "button",
                  "callback": "Callbacks.tabIconRotateButton",
                  "position": [ 170, 80 ],
                  "pressedOffset": [ 0, 0 ],
                  "base": "/pat/infinv/images/buttons/rotate.png:base",
                  "hover": "/pat/infinv/images/buttons/rotate.png:base?multiply=aff",
                  "pressed": "/pat/infinv/images/buttons/rotate.png:press?multiply=0ff"
                },
                "scrollArea": {
                  "type": "scrollArea",
                  "rect": [ 0, 0, 192, 93 ],
                  "children": {
                    "list": {
                      "type": "container",
                      "size": [ 170, 0 ],
                      "scissoring": false,
                      "data": {
                        "images": "/pat/infinv/images/tabicons/tabicons.json",
                        "iconSlotData": { "tooltipKey": "tabIconSlot" },
                        "iconSlotTemplate": {
                          "type": "itemslot",
                          "position": [ 7, -1 ],
                          "callback": "IconPicker._slotLeft",
                          "rightClickCallback": "IconPicker._slotRight",
                          "mouseTransparent": true,
                          "showCount": false,
                          "showRarity": false,
                          "showDurability": false,
                          "showBackingImageWhenFull": true,
                          "showBackingImageWhenEmpty": true,
                          "backingImage": "/pat/infinv/images/editor/iconslot.png"
                        },
                        "spacing": [ 34, 19 ],
                        "template": {
                          "select": {
                            "type": "image",
                            "zlevel": -10,
                            "file": "/pat/infinv/images/tab/selectedbg.png",
                            "visible": false
                          },
                          "button": {
                            "type": "button",
                            "callback": "IconPicker._select",
                            "position": [ 0, -1 ],
                            "pressedOffset": [ 0, 0 ],
                            "base": "/pat/infinv/images/tab/button.png:base",
                            "hover": "/pat/infinv/images/tab/button.png:hover",
                            "pressed": "/pat/infinv/images/tab/button.png:pressed"
                          },
                          "icon": {
                            "type": "image",
                            "position": [ 16, 8 ],
                            "maxSize": [ 30, 18 ],
                            "zlevel": 2,
                            "centered": true,
                            "mouseTransparent": true
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            {
              "tabName": "border",
              "tabTitle": "Border",
              "children": {
                "scrollArea": {
                  "type": "scrollArea",
                  "rect": [ 0, 0, 192, 93 ],
                  "children": {
                    "list": {
                      "type": "container",
                      "size": [ 125, 0 ],
                      "scissoring": false,
                      "data": {
                        "images": "/pat/infinv/images/borders/borders.json",
                        "tags": { "custom": "FFF" },
                        "iconTags": { "frame": "icon" },
                        "specialTag": "custom",
                        "spacing": [ 25, 23 ],
                        "template": {
                          "select": {
                            "type": "image",
                            "zlevel": -10,
                            "file": "/pat/infinv/images/tab/smallselectedbg.png",
                            "visible": false
                          },
                          "button": {
                            "type": "button",
                            "callback": "BorderPicker._select",
                            "position": [ 0, -1 ],
                            "pressedOffset": [ 0, 0 ],
                            "base": "/pat/infinv/images/tab/smallbutton.png:base",
                            "hover": "/pat/infinv/images/tab/smallbutton.png:hover",
                            "pressed": "/pat/infinv/images/tab/smallbutton.png:pressed"
                          },
                          "icon": {
                            "type": "image",
                            "position": [ 12, 10 ],
                            "maxSize": [ 22, 22 ],
                            "zlevel": 2,
                            "centered": true,
                            "mouseTransparent": true
                          },
                          "special": {
                            "type": "image",
                            "position": [ 15, 2 ],
                            "zlevel": 4,
                            "visible": false,
                            "mouseTransparent": true,
                            "file": "/pat/infinv/images/editor/recolorable.png"
                          }
                        }
                      }
                    }
                  }
                },
                "colorBg": {
                  "type": "image",
                  "position": [ 131, 73 ],
                  "file": "/pat/infinv/images/editor/textboxsmall.png"
                },
                "colorTextbox": {
                  "type": "textbox",
                  "hint": "^#444;hex color",
                  "regex": "[a-fA-F0-9]{0,8}",
                  "position": [ 133, 76 ],
                  "textAlign": "center",
                  "maxWidth": 35,
                  "callback": "BorderColorbox._input",
                  "enterKey": "Callbacks.blur"
                },
                "setDefault": {
                  "type": "button",
                  "callback": "Callbacks.tabSetDefault",
                  "position": [ 141, 8 ],
                  "base": "/pat/infinv/images/buttons/floppy.png",
                  "hover": "/pat/infinv/images/buttons/floppy.png?multiply=faa",
                  "pressed": "/pat/infinv/images/buttons/floppy.png?multiply=f00",
                  "data": { "tooltipKey": "tabSetDefault" }
                },
                "reset": {
                  "type": "button",
                  "callback": "Callbacks.tabResetToDefault",
                  "position": [ 155, 8 ],
                  "base": "/pat/infinv/images/buttons/reset.png:base",
                  "hover": "/pat/infinv/images/buttons/reset.png:base?multiply=afa",
                  "pressed": "/pat/infinv/images/buttons/reset.png:press?multiply=0f0",
                  "data": { "tooltipKey": "tabResetToDefault" }
                }
              }
            },
            {
              "tabName": "backing",
              "tabTitle": "Slots",
              "children": {
                "scrollArea": {
                  "type": "scrollArea",
                  "rect": [ 0, 0, 192, 93 ],
                  "children": {
                    "list": {
                      "type": "container",
                      "size": [ 125, 0 ],
                      "scissoring": false,
                      "data": {
                        "images": "/pat/infinv/images/slots/slotbacks.json",
                        "tags": { "custom": "FFF" },
                        "specialTag": "custom",
                        "spacing": [ 25, 23 ],
                        "template": {
                          "select": {
                            "type": "image",
                            "zlevel": -10,
                            "file": "/pat/infinv/images/tab/smallselectedbg.png",
                            "visible": false
                          },
                          "button": {
                            "type": "button",
                            "callback": "BackingPicker._select",
                            "position": [ 0, -1 ],
                            "pressedOffset": [ 0, 0 ],
                            "base": "/pat/infinv/images/tab/smallbutton.png:base",
                            "hover": "/pat/infinv/images/tab/smallbutton.png:hover",
                            "pressed": "/pat/infinv/images/tab/smallbutton.png:pressed"
                          },
                          "icon": {
                            "type": "image",
                            "position": [ 12, 10 ],
                            "maxSize": [ 24, 22 ],
                            "zlevel": 2,
                            "centered": true,
                            "mouseTransparent": true
                          },
                          "special": {
                            "type": "image",
                            "position": [ 15, 2 ],
                            "zlevel": 4,
                            "visible": false,
                            "mouseTransparent": true,
                            "file": "/pat/infinv/images/editor/recolorable.png"
                          }
                        }
                      }
                    }
                  }
                },
                "fullCheckbox": {
                  "type": "button",
                  "position": [ 129, 54 ],
                  "pressedOffset": [ 0, 0 ],
                  "caption": "Show slot\nwhen full",
                  "fontSize": 7,
                  "textAlign": "left",
                  "textOffset": [ 12, 1 ],
                  "scissoring": false,
                  "base": "/pat/infinv/images/buttons/checkbox.png:base",
                  "hover": "/pat/infinv/images/buttons/checkbox.png:hover",
                  "pressed": "/pat/infinv/images/buttons/checkbox.png:press",
                  "baseImageChecked": "/pat/infinv/images/buttons/checkbox.png:baseChecked",
                  "hoverImageChecked": "/pat/infinv/images/buttons/checkbox.png:hoverChecked",
                  "pressedImageChecked": "/pat/infinv/images/buttons/checkbox.png:pressChecked",
                  "callback": "Callbacks.tabBackingFullCheckbox"
                },
                "colorBg": {
                  "type": "image",
                  "position": [ 131, 73 ],
                  "file": "/pat/infinv/images/editor/textboxsmall.png"
                },
                "colorTextbox": {
                  "type": "textbox",
                  "hint": "^#444;hex color",
                  "regex": "[a-fA-F0-9]{0,8}",
                  "position": [ 133, 76 ],
                  "textAlign": "center",
                  "maxWidth": 35,
                  "callback": "BackingColorbox._input",
                  "enterKey": "Callbacks.blur"
                },
                "setDefault": {
                  "type": "button",
                  "callback": "Callbacks.tabSetDefault",
                  "position": [ 141, 8 ],
                  "base": "/pat/infinv/images/buttons/floppy.png",
                  "hover": "/pat/infinv/images/buttons/floppy.png?multiply=faa",
                  "pressed": "/pat/infinv/images/buttons/floppy.png?multiply=f00",
                  "data": { "tooltipKey": "tabSetDefault" }
                },
                "reset": {
                  "type": "button",
                  "callback": "Callbacks.tabResetToDefault",
                  "position": [ 155, 8 ],
                  "base": "/pat/infinv/images/buttons/reset.png:base",
                  "hover": "/pat/infinv/images/buttons/reset.png:base?multiply=afa",
                  "pressed": "/pat/infinv/images/buttons/reset.png:press?multiply=0f0",
                  "data": { "tooltipKey": "tabResetToDefault" }
                }
              }
            }
          ]
        },
        "bgTop": {
          "type": "imageStretch",
          "rect": [ 47, 107, 248, 140 ],
          "zlevel": -100,
          "scissoring": false,
          "mouseTransparent": true,
          "stretchSet": {
            "begin": "/pat/infinv/images/editor/background.png:top.begin",
            "inner": "/pat/infinv/images/editor/background.png:top.inner",
            "end": "/pat/infinv/images/editor/background.png:top.end"
          }
        },
        "bgBottom": {
          "type": "imageStretch",
          "rect": [ 47, 15, 248, 107 ],
          "zlevel": -100,
          "scissoring": false,
          "mouseTransparent": true,
          "stretchSet": { "inner": "/pat/infinv/images/editor/background.png:bottom" }
        },
        "scrollBar": {
          "type": "imageStretch",
          "rect": [ 238, 14, 249, 109 ],
          "zlevel": -95,
          "direction": "vertical",
          "stretchSet": {
            "begin": "/pat/infinv/images/scrollback.png:begin",
            "inner": "/pat/infinv/images/scrollback.png:inner",
            "end": "/pat/infinv/images/scrollback.png:end"
          }
        },
        "_block": {
          "type": "scrollArea",
          "rect": [ 47, 15, 248, 140 ],
          "zlevel": -100,
          "verticalScroll": false
        }
      }
    },
    "_blur": { "type": "widget", "size": [ 250, 166 ], "zlevel": -999.9 }
  },

  // adjusts widgets with pane size. bad
  "autoLayout": {
    "defaultSize": [ 250, 166 ],
    "headerHeight": 25,
    "footerHeight": 14,
    "resizeImage": "/pat/infinv/images/panesize.png",
    "widgets": {
      "bgStretch.header": [ "y", "h" ],
      "bgStretch.body": [ "h", "v" ],
      "bgStretch.back": [ "h", "v" ],
