      "subtitleText": [ "y" ],
      "searchButton": [ "x", "y" ],
      "search": [ "x", "y" ],
      "close": [ "x", "y" ],
      "bagTabs": [ "v" ],
      "bagScrollBar": [ "v" ],
      "gridLayout.prevPageButton": [ "x_center" ],
      "gridLayout.nextPageButton": [ "x_center" ],
      "gridLayout.pageLabel": [ "x_center" ],
      "gridLayout.pageTextbox": [ "x_center" ],
      "gridLayout.pageTextboxBg": [ "x_center" ],
      "gridLayout.pageScroller": [ "h", "v" ],
      "gridLayout.pageBar": [ "h" ],
      "gridLayout.sortButton": [ "x" ],
      "gridLayout.quickStackButton": [ "x" ],
      "gridLayout.takeAllButton": [ "x" ],
      "gridLayout.quickMoveCheckbox": [ "x" ],
      "editorLayout.labelBg": [ "y" ],
      "editorLayout.labelTextbox": [ "y" ],
      "editorLayout.moveTabUpButton": [ "x", "y" ],
      "editorLayout.moveTabDownButton": [ "x", "y" ],
      "editorLayout.deleteTabButton": [ "x", "y" ],
      "editorLayout.bgTop": [ "y", "h" ],
      "editorLayout.bgBottom": [ "h", "v" ],
      "editorLayout.scrollBar": [ "x", "v" ],
      "editorLayout.editorTabs": [ "h", "v" ],
      "editorLayout.editorTabs.tabs.icon": [ "h", "v" ],
      "editorLayout.editorTabs.tabs.icon.scrollArea": [ "h", "v" ],
      "editorLayout.editorTabs.tabs.icon.scrollArea.list": [ "h" ],
      "editorLayout.editorTabs.tabs.icon.rotateIconButton": [ "x", "y" ],
      "editorLayout.editorTabs.tabs.border": [ "h", "v" ],
      "editorLayout.editorTabs.tabs.border.scrollArea": [ "h", "v" ],
      "editorLayout.editorTabs.tabs.border.scrollArea.list": [ "h" ],
      "editorLayout.editorTabs.tabs.border.colorBg": [ "x", "y" ],
      "editorLayout.editorTabs.tabs.border.colorTextbox": [ "x", "y" ],
      "editorLayout.editorTabs.tabs.border.setDefault": [ "x" ],
      "editorLayout.editorTabs.tabs.border.reset": [ "x" ],
      "editorLayout.editorTabs.tabs.backing": [ "h", "v" ],
      "editorLayout.editorTabs.tabs.backing.scrollArea": [ "h", "v" ],
      "editorLayout.editorTabs.tabs.backing.scrollArea.list": [ "h" ],
      "editorLayout.editorTabs.tabs.backing.colorBg": [ "x", "y" ],
      "editorLayout.editorTabs.tabs.backing.colorTextbox": [ "x", "y" ],
      "editorLayout.editorTabs.tabs.backing.fullCheckbox": [ "x", "y" ],
      "editorLayout.editorTabs.tabs.backing.setDefault": [ "x" ],
      "editorLayout.editorTabs.tabs.backing.reset": [ "x" ],
      "editorLayout._block": [ "h", "v" ],
      "_blur": [ "h", "v" ]
    }
  }
}
